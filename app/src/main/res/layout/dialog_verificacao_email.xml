<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_verificacao_email"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/conteiner_dashboard"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_email" />

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Verifique seu e-mail"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMensagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Enviamos um link de verificação para seu e-mail. Por favor, acesse sua caixa de entrada e confirme."
        android:textColor="#555555"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvMensagem2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Em seguida retorne a tela inicial e realize o login."
        android:textColor="#555555"
        android:textSize="16sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReenviarEmail"
        style="@style/mediumButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Reenviar e-mail" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnFechar"
        style="@style/mediumButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#DDDDDD"
        android:text="Fechar"
        android:textColor="#333333" />
</LinearLayout>
